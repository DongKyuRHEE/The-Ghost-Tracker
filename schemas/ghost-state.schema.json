{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GhostState",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "snapshot_id",
    "sequence",
    "timestamp",
    "x_total",
    "y_total",
    "z_total",
    "ci_score",
    "confidence",
    "channels"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "snapshot_id": {
      "type": "string",
      "minLength": 1
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "previous_snapshot_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "x_total": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "y_total": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "z_total": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "ci_score": {
      "type": "number"
    },
    "confidence": {
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH"
      ]
    },
    "confidence_reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "observation_count": {
          "type": "integer",
          "minimum": 0
        },
        "comparable_observation_count": {
          "type": "integer",
          "minimum": 0
        },
        "task_diversity_count": {
          "type": "integer",
          "minimum": 0
        },
        "baseline_available": {
          "type": "boolean"
        },
        "environment_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "baseline": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "x_mean": {
          "type": "number"
        },
        "y_mean": {
          "type": "number"
        },
        "z_mean": {
          "type": "number"
        },
        "x_deviation": {
          "type": "number"
        },
        "y_deviation": {
          "type": "number"
        },
        "z_deviation": {
          "type": "number"
        }
      }
    },
    "delta": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "z"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "z": {
          "type": "number"
        }
      }
    },
    "behavioral_change": {
      "enum": [
        "IMPROVING",
        "DETERIORATING",
        "STABLE",
        "MIXED",
        "INSUFFICIENT_CONTEXT"
      ]
    },
    "masking_risk": {
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "UNKNOWN"
      ]
    },
    "protocol_alpha": {
      "type": "boolean"
    },
    "protocol_beta": {
      "type": "boolean"
    },
    "channels": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "axis",
          "channel",
          "intensity",
          "legacy_label",
          "proxy_evidence"
        ],
        "properties": {
          "axis": {
            "enum": [
              "X",
              "Y",
              "Z"
            ]
          },
          "channel": {
            "type": "string"
          },
          "intensity": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4
          },
          "legacy_label": {
            "type": [
              "string",
              "null"
            ]
          },
          "proxy_evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}